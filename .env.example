# Copy to .env and export the values you need. Never commit real credentials.
#
# The CLI reads the process environment, not this file automatically.

# --- Provider credentials -------------------------------------------------
META_API_KEY=
OPENROUTER_API_KEY=
MODEL_API_KEY=
OPENAI_API_KEY=

# --- Provider defaults ----------------------------------------------------
PARADOX_PROVIDER=mock
PARADOX_MODEL=mock-science-v1
PARADOX_BASE_URL=

# Optional cost accounting for OpenAI-compatible endpoints.
# Applies only when the provider does not return its own cost.
PARADOX_INPUT_PRICE_PER_MILLION=
PARADOX_OUTPUT_PRICE_PER_MILLION=

# --- Local persistence ----------------------------------------------------
PARADOX_RUNS_DIR=.paradox/runs
PARADOX_EVAL_DIR=.paradox/evals

# --- HTTP server ----------------------------------------------------------
# Required when binding a non-loopback address.
PARADOX_API_KEY=
